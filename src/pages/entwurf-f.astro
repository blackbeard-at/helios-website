---
// Entwurf F – „Familienähnlichkeit“ (Stand 26.10.2026)
// Stimmung der IEV-Website (Muttergesellschaft), aber eigenständig und jünger.
// Texte und Navigation 1:1 von helios-hilfen.de. Die Bewegung folgt dem Logo:
// Die Sonne gibt drei Strahlen ab (Orange, Hellorange, Gelb).
import { Image } from 'astro:assets';
import DraftLayout from '../layouts/DraftLayout.astro';
import HeliosMark from '../components/HeliosMark.astro';
import { contact, sections, team, leistungen } from '../data/site';
import { hilfen } from '../data/entwurf';
import hero from '../assets/images/hero.jpg';
import vision from '../assets/images/vision.jpg';
import leitbild from '../assets/images/leitbild.jpg';

// Statement: Satz aus dem Original-Hero, das „o“ in „positive“ wird zur Sonne
const statement =
  'Unser Team setzt sich für eine selbstbestimmte und positive Zukunftsperspektive junger Menschen und ihrer Familien ein.'.split(
    ' ',
  );

const photo = (id: string) => hilfen.find((h) => h.id === id)!;

const initials = (name: string) => {
  const parts = name.split(' ').filter((w) => !w.endsWith('.'));
  return (parts[0][0] + parts.at(-1)![0]).toUpperCase();
};

const year = new Date().getFullYear();
---

<DraftLayout title="Entwurf F · Familienähnlichkeit">
  <div class="f">
    <header class="nav">
      <a class="nav__logo" href="#willkommen" aria-label="HELIOS – Kinder- und Familienhilfe, zum Anfang">
        <HeliosMark class="mark-intro" />
      </a>
      <nav class="nav__links" id="nav-f" aria-label="Hauptmenü">
        {sections.map((s) => <a href={`#${s.id}`} data-spy>{s.label}</a>)}
      </nav>
      <button class="nav__menu" type="button" aria-expanded="false" aria-controls="nav-f" data-menu>
        <span class="sr-only">Menü</span><i></i><i></i>
      </button>
    </header>

    <main>
      <!-- Willkommen -->
      <section class="hero" id="willkommen">
        <div class="hero__content">
          <p class="chip hero-in" style="--d:0"><span class="sun-dot" aria-hidden="true"></span>Freier Träger der Kinder- und Jugendhilfe</p>
          <h1 class="hero__title">
            <span class="hero-line"><span class="hero-in" style="--d:1">Willkommen</span></span>
            <span class="hero-line"><span class="hero-in" style="--d:2">bei <mark>HELIOS</mark></span></span>
          </h1>
          <p class="lead hero-in" style="--d:3">
            Wir sind ein freier Träger der ambulanten Kinder- und Jugendhilfe mit Sitz in Bad Vilbel.
          </p>
          <p class="hero__more hero-in" style="--d:4">
            Wir sind ein heterogenes, multiprofessionelles Fachkräfteteam aus unterschiedlichen pädagogischen und
            psychologischen Disziplinen. Dadurch können wir flexibel auf individuelle Bedarfe reagieren und maßgeschneiderte,
            personenorientierte Lösungen entwickeln.
          </p>
          <p class="hero__actions hero-in" style="--d:5">
            <a class="btn btn--primary" href="#leistungen" data-magnet>
              Leistungen
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </a>
            <a class="btn btn--ghost" href="#unser-team" data-magnet>Unser Team</a>
          </p>
        </div>

        <figure class="hero__media">
          <div class="arch arch--hero">
            <Image src={hero} alt="Eine Gruppe Jugendlicher sitzt lachend auf dem Rand einer Skateboard-Bowl" widths={[640, 960, 1400]} sizes="(min-width: 992px) 46vw, 100vw" loading="eager" fetchpriority="high" />
          </div>
          <!-- Großes Sonnen-Zeichen: geht auf und gibt Strahlen ab -->
          <div class="hero__sun">
            <HeliosMark variant="icon" class="mark-emit" />
          </div>
        </figure>
      </section>

      <!-- Statement aus dem Original-Hero, auf einer Fläche in Orange -->
      <section class="statement" aria-label="Unser Anspruch">
        <div class="statement__panel">
          <HeliosMark variant="icon" class="statement__rays" />
          <h2 class="statement__title" data-scrub>
            {
              statement.map((w, i) => (
                <>
                  {i > 0 && ' '}
                  <span class="scrub">
                    {w === 'positive' ? (
                      <>p<span class="sun-o" aria-hidden="true"><span>o</span></span><span class="sr-only">o</span>sitive</>
                    ) : (
                      w
                    )}
                  </span>
                </>
              ))
            }
          </h2>
          <p class="statement__text" data-reveal>
            In enger Zusammenarbeit mit den örtlichen Jugendämtern setzen wir hierfür bedarfsgerechte und nachhaltig wirksame
            sozialpädagogische Maßnahmen um.
          </p>
        </div>
      </section>

      <!-- Unser Leitbild: Vision und Leitbild -->
      <section class="leitbild" id="unser-leitbild" aria-label="Unser Leitbild">
        <div class="split">
          <div class="split__media" data-reveal>
            <div class="arch arch--split">
              <Image src={vision} alt="Eine Pädagogin zeigt zwei Jungen ein kleines Bäumchen" widths={[480, 800]} sizes="(min-width: 992px) 40vw, 100vw" />
            </div>
          </div>
          <div class="split__text">
            <h2 class="chip" data-reveal><span class="sun-dot" aria-hidden="true"></span>Unsere Vision</h2>
            <p class="lead" data-reveal>
              Unsere Vision ist eine Gesellschaft, in der junge Menschen – unabhängig von ihrer Herkunft – gleiche Chancen
              auf ein selbstbestimmtes und eigenverantwortliches Leben erhalten.<br />
              Wir stärken Kinder, Jugendliche und ihre Familien darin, ihre Potenziale zu entfalten und Herausforderungen
              eigenständig zu meistern.<br />
              Um dieser Vision gerecht zu werden, leiten folgende Werte unser Handeln:<br />
              <strong>Respekt, Fairness, Vertrauen und Gleichberechtigung.</strong>
            </p>
          </div>
        </div>

        <div class="split split--reverse">
          <div class="split__media" data-reveal>
            <div class="arch arch--split">
              <Image src={leitbild} alt="Ein Vater baut mit zwei Söhnen ein Windrad-Modell zusammen" widths={[480, 800]} sizes="(min-width: 992px) 40vw, 100vw" />
            </div>
          </div>
          <div class="split__text">
            <h2 class="chip" data-reveal><span class="sun-dot" aria-hidden="true"></span>Unser Leitbild</h2>
            <p class="lead" data-reveal>
              Wir richten unsere Arbeit konsequent an den Ressourcen und <strong>Bedürfnissen der jungen Menschen und ihrer
              Familien</strong> aus. Ziel ist es, durch nachhaltig wirksame Maßnahmen die Notwendigkeit sozialpädagogischer
              Hilfen langfristig zu beenden und die Kompetenz zur selbstbestimmten und gesellschaftskompatiblen Lebensführung
              zu fördern.<br />
              Unsere Fachkräfte entwickeln individuelle, ressourcenorientierte und systemische Handlungsstrategien, die sich
              eng an der Lebenswelt der jungen Menschen orientieren.<br />
              Durch eine vertrauensvolle Zusammenarbeit sowie eine regelmäßige und sensible Begleitung schaffen wir
              tragfähige Beziehungen, die echte Veränderung ermöglichen.
            </p>
          </div>
        </div>
      </section>

      <!-- Leistungen: links die Titel, rechts der Inhalt -->
      <section class="leistungen" id="leistungen" aria-labelledby="leistungen-title">
        <div class="section-head">
          <h2 class="h2" id="leistungen-title" data-reveal>Unsere Leistungen</h2>
          <p class="lead" data-reveal>
            Gemeinsam mit den Hilfesuchenden und dem ortsansässigen Jugendamt wird jede Hilfe bedarfsgerecht und individuell
            gestaltet. Dabei verfolgen wir einen ganzheitlichen systemischen Ansatz. Wir garantieren eine schnelle Einleitung
            der Hilfe, eine hohe Flexibilität und Erreichbarkeit für Klienten und Auftraggeber. Die Hilfen werden stets
            alltagspraktisch und einfach „nah“ am Menschen gestaltet.
          </p>
        </div>

        <div class="tabs" data-tabs>
          <div class="tabs__list" role="tablist" aria-label="Unsere Leistungen" aria-orientation="vertical">
            <span class="tabs__pill" aria-hidden="true"></span>
            {
              leistungen.map((l, i) => (
                <button
                  class="tabs__tab"
                  role="tab"
                  type="button"
                  id={`tab-${l.id}`}
                  aria-controls={`panel-${l.id}`}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  tabindex={i === 0 ? 0 : -1}
                >
                  <span class="tabs__ray" aria-hidden="true"></span>
                  {l.title}
                </button>
              ))
            }
          </div>

          <div class="panels">
            {
              leistungen.map((l, i) => (
                <div class="panel" role="tabpanel" id={`panel-${l.id}`} aria-labelledby={`tab-${l.id}`} data-panel hidden={i !== 0} tabindex="0">
                  <div class="arch arch--panel">
                    <Image src={photo(l.id).photo} alt={photo(l.id).alt} widths={[480, 900]} sizes="(min-width: 992px) 44vw, 100vw" />
                  </div>
                  <h3 class="h3">{l.title}</h3>
                  {l.intro.length > 0 && (
                    <p class="panel__intro">
                      {l.intro.map((line, k) => (
                        <>
                          {k > 0 && <br />}
                          {line}
                        </>
                      ))}
                    </p>
                  )}
                  <div class="panel__body">
                    {l.blocks.map((b) =>
                      b.type === 'h' ? (
                        <h4>{b.text}</h4>
                      ) : b.type === 'p' ? (
                        <p>{b.text}</p>
                      ) : (
                        <ul>
                          {b.items.map((it) => (
                            <li>
                              {it.split('\n').map((part, k) => (
                                <>
                                  {k > 0 && <br />}
                                  {part}
                                </>
                              ))}
                            </li>
                          ))}
                        </ul>
                      ),
                    )}
                  </div>
                  {l.law && (
                    <a class="link-arrow" href={l.law.href} target="_blank" rel="noopener">
                      {l.law.label}
                      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    </a>
                  )}
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Unser Team -->
      <section class="team" id="unser-team" aria-labelledby="team-title">
        <h2 class="h2" id="team-title" data-reveal>Unser Team</h2>
        <ul class="people" data-reveal-group>
          {
            team.map((p) => (
              <li class="person">
                <span class="person__initials" aria-hidden="true">{initials(p.name)}</span>
                <h3>{p.name}</h3>
                <p class="person__role">
                  {p.lines.map((l) => (
                    <span>{l}</span>
                  ))}
                  <strong>{p.role}</strong>
                </p>
                <a class="person__mail" href={`mailto:${p.email}`} aria-label={`E-Mail an ${p.name}`}>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3" fill="none" stroke="currentColor" stroke-width="1.6"></rect><path d="m4 7 8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </main>

    <!-- Footer mit den Angaben der Live-Seite -->
    <footer class="foot">
      <div class="foot__inner">
        <div class="foot__brand">
          <HeliosMark class="mark-intro mark-intro--view" />
        </div>
        <div class="foot__address">
          <h2 class="foot__title">{contact.company}</h2>
          <p>{contact.street}<br />{contact.city}</p>
          <p>
            Tel.: <a href={contact.phoneHref}>{contact.phone}</a><br />
            Fax: {contact.fax}<br />
            Email: <a href={`mailto:${contact.email}`}>{contact.email.replace('@', '(at)')}</a>
          </p>
          <p>Geschäftsführung:<br />{contact.management}<br />{contact.court}<br />{contact.register}</p>
        </div>
        <div class="map" data-map={contact.mapsEmbed}>
          <div class="map__consent">
            <p>Beim Laden der Karte werden Daten an Google übertragen. Mehr dazu in der <a href="/datenschutz">Datenschutzerklärung</a>.</p>
            <button class="btn btn--primary btn--sm" type="button" data-map-load>Karte laden</button>
            <a href={contact.mapsLink} target="_blank" rel="noopener">In Google Maps öffnen</a>
          </div>
        </div>
      </div>
      <div class="foot__meta">
        <p><a href="/impressum">Impressum</a> | <a href="/datenschutz">Datenschutz</a></p>
        <p>© {`${year} ${contact.brand}`}. <span style="white-space:nowrap">All rights reserved</span></p>
      </div>
    </footer>
  </div>
</DraftLayout>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)').matches;

  /* ---------- Einblenden beim Scrollen ---------- */
  const revealEls = document.querySelectorAll<HTMLElement>('[data-reveal], [data-reveal-group], .mark-intro--view');
  if (reduce || !('IntersectionObserver' in window)) {
    revealEls.forEach((el) => el.classList.add('is-visible'));
  } else {
    document.querySelectorAll('section').forEach((s) =>
      s.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el, i) => el.style.setProperty('--rd', `${(i % 4) * 60}ms`)),
    );
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      },
      { rootMargin: '0px 0px -12% 0px' },
    );
    revealEls.forEach((el) => io.observe(el));
  }

  /* ---------- Statement: Wörter färben sich mit dem Scrollen ein ---------- */
  const scrub = document.querySelector<HTMLElement>('[data-scrub]');
  if (scrub && !reduce) {
    const words = [...scrub.querySelectorAll<HTMLElement>('.scrub')];
    scrub.classList.add('is-scrubbing');
    const update = () => {
      const r = scrub.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (innerHeight * 0.9 - r.top) / (innerHeight * 0.55)));
      const lit = p * words.length;
      words.forEach((w, i) => w.style.setProperty('--lit', String(Math.min(1, Math.max(0, lit - i)))));
      // Sobald der Satz eingefärbt ist, gibt die Sonne im „o“ ihre Strahlen ab
      scrub.classList.toggle('is-done', p >= 1);
    };
    addEventListener('scroll', update, { passive: true });
    update();
  }

  /* ---------- Leistungen: senkrechte Tabs, Pille gleitet mit ---------- */
  const tabs = document.querySelector<HTMLElement>('[data-tabs]');
  if (tabs) {
    const list = tabs.querySelector<HTMLElement>('.tabs__list')!;
    const pill = tabs.querySelector<HTMLElement>('.tabs__pill')!;
    const btns = [...tabs.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...tabs.querySelectorAll<HTMLElement>('[data-panel]')];
    const active = () => btns.find((b) => b.getAttribute('aria-selected') === 'true')!;
    const place = (btn: HTMLButtonElement) => {
      pill.style.width = `${btn.offsetWidth}px`;
      pill.style.height = `${btn.offsetHeight}px`;
      pill.style.transform = `translate(${btn.offsetLeft}px, ${btn.offsetTop}px)`;
    };
    const select = (btn: HTMLButtonElement, focus = false) => {
      btns.forEach((b) => {
        const on = b === btn;
        b.setAttribute('aria-selected', String(on));
        b.tabIndex = on ? 0 : -1;
      });
      panels.forEach((p) => {
        const on = p.id === btn.getAttribute('aria-controls');
        p.hidden = !on;
        if (on) {
          p.classList.remove('is-in');
          void p.offsetWidth;
          p.classList.add('is-in');
        }
      });
      place(btn);
      if (focus) btn.focus();
    };
    btns.forEach((b, i) => {
      b.addEventListener('click', () => select(b));
      b.addEventListener('keydown', (e) => {
        const dir = ['ArrowDown', 'ArrowRight'].includes(e.key) ? 1 : ['ArrowUp', 'ArrowLeft'].includes(e.key) ? -1 : 0;
        if (!dir) return;
        e.preventDefault();
        select(btns[(i + dir + btns.length) % btns.length], true);
      });
    });
    list.classList.add('has-pill');
    place(btns[0]);
    addEventListener('resize', () => place(active()));
    document.fonts?.ready.then(() => place(active()));
  }

  /* ---------- Magnetische Knöpfe (wie IEV, mit Feder) ---------- */
  if (finePointer && !reduce) {
    document.querySelectorAll<HTMLElement>('[data-magnet]').forEach((el) => {
      let tx = 0, ty = 0, x = 0, y = 0, vx = 0, vy = 0, raf = 0;
      const MAX = 6;
      const tick = () => {
        vx = (vx + (tx - x) * 0.12) * 0.72;
        vy = (vy + (ty - y) * 0.12) * 0.72;
        x += vx;
        y += vy;
        el.style.transform = `translate3d(${x.toFixed(2)}px, ${y.toFixed(2)}px, 0)`;
        raf = Math.abs(tx - x) + Math.abs(ty - y) + Math.abs(vx) + Math.abs(vy) > 0.05 ? requestAnimationFrame(tick) : 0;
      };
      const run = () => {
        if (!raf) raf = requestAnimationFrame(tick);
      };
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        tx = Math.max(-MAX, Math.min(MAX, (e.clientX - r.left - r.width / 2) * 0.18));
        ty = Math.max(-MAX, Math.min(MAX, (e.clientY - r.top - r.height / 2) * 0.3));
        run();
      });
      el.addEventListener('pointerleave', () => {
        tx = 0;
        ty = 0;
        run();
      });
    });
  }

  /* ---------- Karte erst nach Klick ---------- */
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((map) =>
    map.querySelector('[data-map-load]')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = map.dataset.map!;
      iframe.title = 'Standort HELIOS Hilfen GmbH auf Google Maps';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      map.replaceChildren(iframe);
    }),
  );

  /* ---------- Navigation: aktiver Abschnitt, Menü auf dem Telefon ---------- */
  const navEl = document.querySelector<HTMLElement>('.nav')!;
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-spy]')];
  const secs = links.map((a) => document.querySelector<HTMLElement>(a.hash)!).filter(Boolean);
  const spy = () => {
    navEl.classList.toggle('is-stuck', scrollY > 8);
    let cur = secs[0]?.id ?? '';
    for (const s of secs) if (s.getBoundingClientRect().top < innerHeight * 0.4) cur = s.id;
    links.forEach((a) => a.classList.toggle('is-active', a.hash === `#${cur}`));
  };
  addEventListener('scroll', spy, { passive: true });
  spy();
  const menu = document.querySelector<HTMLButtonElement>('[data-menu]')!;
  menu.addEventListener('click', () => {
    const open = menu.getAttribute('aria-expanded') !== 'true';
    menu.setAttribute('aria-expanded', String(open));
    navEl.classList.toggle('is-open', open);
  });
  links.forEach((a) =>
    a.addEventListener('click', () => {
      menu.setAttribute('aria-expanded', 'false');
      navEl.classList.remove('is-open');
    }),
  );
</script>

<style is:global>
  /* ---------- Tokens: Familienfarben von IEV + HELIOS-Sonne ---------- */
  .f {
    --ink: #323335; /* Anthrazit, geteilt mit IEV */
    --ink-soft: #5b5c60;
    --paper: #ffffff;
    --cream: #f6f1e8; /* Creme, geteilt mit IEV */
    --cream-dark: #ede4d4;
    --line: rgba(50, 51, 53, 0.12);
    --orange: #ec6622;
    --orange-2: #f39222;
    --yellow: #fdc41a;
    --orange-text: #c4501a; /* orange Schrift auf Weiß/Creme, ≥ 4,5:1 */
    --on-orange: #1f1d1c;

    --h1: clamp(2.6rem, 1.6rem + 3.8vw, 4.8rem);
    --h2: clamp(2rem, 1.5rem + 1.9vw, 3.1rem);
    --h3: clamp(1.4rem, 1.2rem + 0.8vw, 2rem);
    --text-large: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);

    --pad-x: clamp(1.25rem, 4.5vw, 4rem);
    --pad-y: clamp(4.5rem, 9vw, 8rem);
    --container: 80rem;
    --nav-h: 96px;

    /* Kurven nach Emil Kowalski */
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    --ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);

    overflow-x: clip;
    background: var(--paper);
    color: var(--ink);
    font-size: 17px;
    line-height: 1.65;
  }

  html:has(.f) {
    scroll-behavior: smooth;
    scroll-padding-top: 96px;
  }

  .f h1,
  .f h2,
  .f h3 {
    color: var(--ink);
    text-wrap: balance;
  }

  .f .h2 {
    font-size: var(--h2);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.03em;
  }

  .f .h3 {
    font-size: var(--h3);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    hyphens: auto;
  }

  .f .lead {
    color: var(--ink-soft);
    font-size: var(--text-large);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .f .lead strong {
    color: var(--ink);
  }

  .f .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
    padding: 0.4rem 0.9rem 0.4rem 0.6rem;
    border-radius: 999px;
    background: var(--cream);
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0;
  }

  /* Sonnenpunkt: gibt beim Erscheinen einmal einen Strahlenring ab */
  .f .sun-dot {
    position: relative;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--orange);
  }

  .f .sun-dot::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 2px solid var(--yellow);
  }

  @media (prefers-reduced-motion: no-preference) {
    .js .f .chip.is-visible .sun-dot::after,
    .js .f .hero .sun-dot::after {
      animation: f-emit-ring 1400ms var(--ease-out) 300ms both;
    }
  }

  @keyframes f-emit-ring {
    0% {
      opacity: 1;
      transform: scale(0.6);
    }
    60% {
      opacity: 0.6;
      transform: scale(2.2);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* ---------- Knöpfe ---------- */
  .f .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 3.25rem;
    padding: 0.8rem 1.6rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    font: inherit;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      color 200ms ease;
  }

  .f .btn:active {
    scale: 0.97;
  }

  .f .btn svg {
    width: 20px;
    height: 20px;
    transition: transform 250ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .f .btn:hover svg {
      transform: translateX(3px);
    }
  }

  .f .btn--sm {
    min-height: 2.75rem;
    padding: 0.55rem 1.15rem;
    font-size: 0.9375rem;
  }

  .f .btn--primary {
    background: var(--orange);
    color: var(--on-orange);
  }

  .f .btn--primary:hover {
    background: var(--orange-2);
  }

  .f .btn--ghost {
    border-color: var(--line);
    color: var(--ink);
  }

  .f .btn--ghost:hover {
    border-color: var(--ink);
    background: var(--cream);
  }

  .f .link-arrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
  }

  .f .link-arrow svg {
    flex: none;
    width: 18px;
    height: 18px;
    color: var(--orange-text);
    transition: transform 250ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .f .link-arrow:hover svg {
      transform: translateX(4px);
    }
  }

  /* ---------- Logo: Sonne gibt Strahlen ab ----------
     Die Strahlen skalieren aus dem Mittelpunkt der Sonne (52/74 im Logo). */
  .f .helios-mark {
    display: block;
    width: auto;
    overflow: visible;
  }

  .f .helios-mark .ray,
  .f .helios-mark .sun {
    transform-box: view-box;
    transform-origin: 52px 74px;
  }

  .f .helios-mark--icon .ray,
  .f .helios-mark--icon .sun {
    transform-origin: 52px 46px; /* viewBox beginnt bei y = 28 */
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Einstieg: erst die Sonne, dann nacheinander die drei Strahlen, dann die Schrift */
    .js .f .mark-intro .sun {
      animation: f-sun-in 700ms var(--ease-out) 100ms both;
    }

    .js .f .mark-intro .ray {
      animation: f-ray-out 800ms var(--ease-out) both;
    }

    .js .f .mark-intro .ray--1 {
      animation-delay: 420ms;
    }
    .js .f .mark-intro .ray--2 {
      animation-delay: 540ms;
    }
    .js .f .mark-intro .ray--3 {
      animation-delay: 660ms;
    }

    .js .f .mark-intro .mark__word {
      animation: f-word-in 700ms var(--ease-out) 760ms both;
    }

    /* Im Footer erst, wenn das Logo sichtbar wird */
    .js .f .mark-intro--view:not(.is-visible) .sun,
    .js .f .mark-intro--view:not(.is-visible) .ray,
    .js .f .mark-intro--view:not(.is-visible) .mark__word {
      animation-play-state: paused;
    }
  }

  @keyframes f-sun-in {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
  }

  @keyframes f-ray-out {
    from {
      opacity: 0;
      transform: scale(0.55);
    }
  }

  @keyframes f-word-in {
    from {
      opacity: 0;
      transform: translateX(-12px);
    }
  }

  /* ---------- Navigation: größeres Logo ---------- */
  .f .nav {
    position: sticky;
    z-index: 40;
    top: 0;
    display: flex;
    align-items: center;
    gap: 2rem;
    height: var(--nav-h);
    padding-inline: var(--pad-x);
    background: rgba(255, 255, 255, 0.95);
    transition:
      height 300ms var(--ease-out),
      box-shadow 250ms ease;
  }

  .f .nav.is-stuck {
    height: 76px;
    box-shadow: 0 1px 0 var(--line);
  }

  .f .nav__logo .helios-mark {
    height: 64px;
    transition: height 300ms var(--ease-out);
  }

  .f .nav.is-stuck .nav__logo .helios-mark {
    height: 52px;
  }

  .f .nav__links {
    display: flex;
    gap: 2rem;
    margin-left: auto;
  }

  /* Aktiver Abschnitt: Sonnenpunkt links (wie IEV ihren roten Punkt) */
  .f .nav__links a {
    position: relative;
    padding-left: 0.95rem;
    color: var(--ink);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
  }

  .f .nav__links a::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 7px;
    height: 7px;
    margin-top: -3.5px;
    border-radius: 50%;
    background: var(--orange);
    box-shadow: 0 0 0 0 rgba(253, 196, 26, 0.7);
    opacity: 0;
    scale: 0.4;
    transition:
      opacity 200ms ease,
      scale 250ms var(--ease-out),
      box-shadow 500ms var(--ease-out);
  }

  .f .nav__links a.is-active::before {
    opacity: 1;
    scale: 1;
    box-shadow: 0 0 0 3px rgba(253, 196, 26, 0.55);
  }

  @media (hover: hover) and (pointer: fine) {
    .f .nav__links a:hover::before {
      opacity: 0.5;
      scale: 1;
    }
  }

  .f .nav__menu {
    display: none;
  }

  @media (max-width: 900px) {
    .f {
      --nav-h: 76px;
    }

    .f .nav {
      gap: 0.75rem;
      justify-content: space-between;
    }

    .f .nav.is-stuck {
      height: 64px;
    }

    .f .nav__logo .helios-mark {
      height: 48px;
    }

    .f .nav.is-stuck .nav__logo .helios-mark {
      height: 40px;
    }

    .f .nav__menu {
      position: relative;
      display: block;
      width: 44px;
      height: 44px;
      border: 0;
      border-radius: 50%;
      background: var(--cream);
      cursor: pointer;
    }

    .f .nav__menu i {
      position: absolute;
      left: 13px;
      width: 18px;
      height: 2px;
      border-radius: 1px;
      background: var(--ink);
      transition: transform 250ms var(--ease-out);
    }

    .f .nav__menu i:first-of-type {
      top: 17px;
    }

    .f .nav__menu i:last-of-type {
      top: 25px;
    }

    .f .nav.is-open .nav__menu i:first-of-type {
      transform: translateY(4px) rotate(45deg);
    }

    .f .nav.is-open .nav__menu i:last-of-type {
      transform: translateY(-4px) rotate(-45deg);
    }

    .f .nav__links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      margin: 0;
      padding: 0.5rem var(--pad-x) 1.5rem;
      background: var(--paper);
      box-shadow: 0 16px 32px rgba(50, 51, 53, 0.1);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition:
        opacity 200ms ease,
        transform 250ms var(--ease-out),
        visibility 0s linear 250ms;
    }

    .f .nav.is-open .nav__links {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition:
        opacity 200ms ease,
        transform 250ms var(--ease-out);
    }

    .f .nav__links a {
      padding-block: 0.85rem;
      border-bottom: 1px solid var(--line);
      font-size: 1.125rem;
    }
  }

  /* ---------- Hero ---------- */
  .f .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    column-gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    max-width: calc(var(--container) + 2 * var(--pad-x));
    min-height: calc(100svh - var(--nav-h));
    margin-inline: auto;
    padding: 1.5rem var(--pad-x) 3rem;
  }

  .f .hero__title {
    font-size: var(--h1);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.04em;
  }

  .f .hero-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }

  .f .hero-line > span {
    display: inline-block;
  }

  /* Marker unter „HELIOS“, wie im Original */
  .f mark {
    background: linear-gradient(transparent 60%, var(--orange) 60%, var(--orange) 92%, transparent 92%);
    color: inherit;
  }

  .f .hero .lead {
    max-width: 36rem;
    margin-top: 1.5rem;
    color: var(--ink);
    font-weight: 500;
  }

  .f .hero__more {
    max-width: 36rem;
    margin-top: 1rem;
    color: var(--ink-soft);
  }

  .f .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .f .hero__media {
    position: relative;
    margin: 0;
    padding: 2.5rem 0 0 2.5rem;
  }

  .f .arch {
    overflow: hidden;
    border-radius: 999px 999px 28px 28px;
    background: var(--cream);
  }

  .f .arch img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .f .arch--hero {
    aspect-ratio: 4 / 4.5;
    max-height: calc(100svh - var(--nav-h) - 5rem);
    margin-left: auto;
  }

  /* Das Sonnenzeichen sitzt oben links am Bogen und strahlt hinein */
  .f .hero__sun {
    position: absolute;
    top: 0;
    left: 0;
    width: clamp(110px, 12vw, 170px);
    padding: 14px;
    border-radius: 32px;
    background: var(--paper);
    box-shadow: 0 18px 40px -18px rgba(50, 51, 53, 0.35);
  }

  .f .hero__sun .helios-mark {
    width: 100%;
    height: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .js .f .hero-in {
      animation: f-rise 900ms var(--ease-out) both;
      animation-delay: calc(var(--d) * 70ms + 200ms);
    }

    .js .f .hero-line .hero-in {
      animation-name: f-line;
    }

    /* Foto öffnet sich von unten wie ein Sonnenaufgang */
    .js .f .arch--hero {
      animation: f-unveil 1300ms var(--ease-in-out) 150ms both;
    }

    .js .f .arch--hero img {
      animation: f-settle 1800ms var(--ease-out) 150ms both;
    }

    .js .f .hero__sun {
      animation: f-pop 700ms var(--ease-out) 700ms both;
    }

    /* Großes Zeichen: Sonne geht auf, Strahlen treten nacheinander aus ihr
       heraus und „senden“ danach in ruhigen Abständen weiter */
    .js .f .mark-emit .sun {
      animation:
        f-sun-rise 900ms var(--ease-out) 900ms both,
        f-sun-glow 4.8s ease-in-out 2.6s infinite;
    }

    .js .f .mark-emit .ray {
      animation:
        f-ray-out 900ms var(--ease-out) both,
        f-ray-pulse 4.8s ease-in-out infinite;
    }

    .js .f .mark-emit .ray--1 {
      animation-delay: 1300ms, 2600ms;
    }
    .js .f .mark-emit .ray--2 {
      animation-delay: 1450ms, 2750ms;
    }
    .js .f .mark-emit .ray--3 {
      animation-delay: 1600ms, 2900ms;
    }
  }

  @keyframes f-rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  @keyframes f-line {
    from {
      transform: translateY(105%);
    }
  }

  @keyframes f-unveil {
    from {
      clip-path: inset(100% 0 0 0 round 999px 999px 28px 28px);
    }
    to {
      clip-path: inset(0 0 0 0 round 999px 999px 28px 28px);
    }
  }

  @keyframes f-settle {
    from {
      transform: scale(1.12);
    }
  }

  @keyframes f-pop {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.92);
    }
  }

  @keyframes f-sun-rise {
    from {
      opacity: 0;
      transform: translateY(40px) scale(0.7);
    }
  }

  @keyframes f-sun-glow {
    0%,
    100% {
      transform: none;
    }
    12% {
      transform: scale(1.06);
    }
  }

  /* Ein Strahl löst sich kurz von der Sonne und kehrt zurück: gestaffelt
     wirkt das wie eine Welle, die nach außen läuft */
  @keyframes f-ray-pulse {
    0%,
    30%,
    100% {
      transform: none;
    }
    14% {
      transform: scale(1.07);
    }
  }

  @media (max-width: 991px) {
    .f .hero {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
      padding-top: 2rem;
    }

    .f .hero__media {
      max-width: 560px;
      margin-top: 2.5rem;
      padding: 1.75rem 0 0 1.75rem;
    }

    .f .arch--hero {
      max-height: none;
    }
  }

  /* ---------- Einblenden beim Scrollen ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .js .f [data-reveal],
    .js .f [data-reveal-group] > * {
      opacity: 0;
      transform: translateY(20px);
      transition:
        opacity 700ms var(--ease-out),
        transform 800ms var(--ease-out);
      transition-delay: var(--rd, 0ms);
    }

    .js .f [data-reveal-group] > :nth-child(2) {
      transition-delay: 60ms;
    }
    .js .f [data-reveal-group] > :nth-child(3) {
      transition-delay: 120ms;
    }
    .js .f [data-reveal-group] > :nth-child(4) {
      transition-delay: 180ms;
    }

    .js .f [data-reveal].is-visible,
    .js .f [data-reveal-group].is-visible > * {
      opacity: 1;
      transform: none;
    }
  }

  /* ---------- Statement auf Orange ---------- */
  .f .statement {
    padding: 0 var(--pad-x);
  }

  .f .statement__panel {
    position: relative;
    max-width: var(--container);
    margin-inline: auto;
    padding: clamp(3.5rem, 8vw, 7rem) clamp(1.5rem, 7vw, 7rem);
    overflow: hidden;
    border-radius: 40px;
    background: var(--orange);
    color: var(--on-orange);
    isolation: isolate;
  }

  /* Riesige Strahlen des Logos im Hintergrund, ganz zurückgenommen */
  .f .statement__rays {
    position: absolute;
    z-index: -1;
    right: -6%;
    bottom: -18%;
    width: min(46vw, 560px);
    height: auto;
    opacity: 0.18;
  }

  .f .statement__rays path {
    fill: var(--paper);
  }

  @media (prefers-reduced-motion: no-preference) {
    .js .f .statement__rays .ray {
      animation: f-ray-pulse 6s ease-in-out infinite;
    }
    .js .f .statement__rays .ray--2 {
      animation-delay: 150ms;
    }
    .js .f .statement__rays .ray--3 {
      animation-delay: 300ms;
    }
  }

  .f .statement__title {
    max-width: 22em;
    color: var(--on-orange);
    font-size: clamp(1.9rem, 1.3rem + 2.4vw, 3.6rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.035em;
  }

  /* Nur das Wort mit der Sonne darf nicht umbrechen; lange Wörter
     („Zukunftsperspektive“) dürfen auf dem Handy trennen */
  .f .statement__title {
    hyphens: auto;
  }

  .f .scrub:has(.sun-o) {
    white-space: nowrap;
  }

  @media (max-width: 520px) {
    .f .statement__title {
      font-size: 1.7rem;
    }
  }

  .f .statement__title.is-scrubbing .scrub {
    color: color-mix(in srgb, var(--on-orange) calc(var(--lit, 0) * 100%), rgba(31, 29, 28, 0.32));
  }

  .f .statement__text {
    max-width: 40rem;
    margin-top: 1.75rem;
    font-size: var(--text-large);
    font-weight: 500;
  }

  /* Das „o“ in „positive“ ist eine kleine Sonne, die Strahlenringe abgibt */
  .f .sun-o {
    position: relative;
    display: inline-block;
  }

  .f .sun-o > span {
    visibility: hidden;
  }

  .f .sun-o::before,
  .f .sun-o::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 55%;
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .f .sun-o::before {
    width: 0.52em;
    height: 0.52em;
    background: var(--yellow);
  }

  .f .sun-o::after {
    width: 0.52em;
    height: 0.52em;
    border: 0.06em solid var(--paper);
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .js .f .statement__title.is-done .sun-o::after {
      animation: f-o-emit 2.4s var(--ease-out) infinite;
    }
  }

  @keyframes f-o-emit {
    0% {
      opacity: 0.9;
      transform: translate(-50%, -50%) scale(1);
    }
    70%,
    100% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(2.6);
    }
  }

  /* ---------- Leitbild: zwei Bild-Text-Paare ---------- */
  .f .leitbild {
    max-width: calc(var(--container) + 2 * var(--pad-x));
    margin-inline: auto;
    padding: var(--pad-y) var(--pad-x);
  }

  .f .split {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }

  .f .split + .split {
    margin-top: var(--pad-y);
  }

  .f .split--reverse .split__media {
    order: 2;
  }

  .f .arch--split {
    aspect-ratio: 4 / 4.4;
  }

  .f .split__text .chip {
    font-size: 1rem;
  }

  @media (max-width: 900px) {
    .f .split {
      grid-template-columns: minmax(0, 1fr);
    }

    .f .split--reverse .split__media {
      order: 0;
    }

    .f .split__media {
      max-width: 520px;
    }
  }

  /* ---------- Abschnittskopf (wie IEV) ---------- */
  .f .section-head {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: end;
    gap: 1.5rem 4rem;
    margin-bottom: 3rem;
  }

  @media (max-width: 991px) {
    .f .section-head {
      grid-template-columns: minmax(0, 1fr);
      margin-bottom: 2rem;
    }
  }

  /* ---------- Leistungen: senkrechte Tabs ---------- */
  .f .leistungen {
    max-width: calc(var(--container) + 2 * var(--pad-x));
    margin-inline: auto;
    padding: var(--pad-y) var(--pad-x);
    border-radius: 48px;
    background: var(--cream);
  }

  .f .tabs {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 2.5rem 4rem;
    align-items: start;
  }

  .f .tabs__list {
    position: sticky;
    top: 110px;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .f .tabs__pill {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 20px;
    background: var(--paper);
    box-shadow: 0 1px 3px rgba(50, 51, 53, 0.1);
    transition:
      transform 350ms var(--ease-out),
      height 350ms var(--ease-out);
  }

  .f .tabs__list:not(.has-pill) .tabs__pill {
    display: none;
  }

  .f .tabs__tab {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    width: 100%;
    padding: 1rem 1.15rem;
    border: 0;
    border-radius: 20px;
    background: none;
    color: var(--ink-soft);
    font: inherit;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
    text-align: left;
    cursor: pointer;
    transition: color 200ms ease;
  }

  .f .tabs__list:not(.has-pill) .tabs__tab[aria-selected='true'] {
    background: var(--paper);
  }

  .f .tabs__tab[aria-selected='true'] {
    color: var(--ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .f .tabs__tab:hover {
      color: var(--ink);
    }
  }

  .f .tabs__tab:active {
    scale: 0.98;
  }

  /* Kleiner Strahlpunkt vor jedem Tab: beim aktiven Tab sendet er Ringe aus */
  .f .tabs__ray {
    flex: none;
    width: 0.75rem;
    height: 0.75rem;
    margin-top: 0.35rem;
    border-radius: 50%;
    border: 2px solid rgba(50, 51, 53, 0.25);
    transition:
      border-color 250ms ease,
      background-color 250ms ease,
      box-shadow 500ms var(--ease-out);
  }

  .f .tabs__tab[aria-selected='true'] .tabs__ray {
    border-color: var(--orange);
    background: var(--orange);
    box-shadow:
      0 0 0 4px rgba(243, 146, 34, 0.35),
      0 0 0 8px rgba(253, 196, 26, 0.25);
  }

  .f .panel {
    outline-offset: 6px;
  }

  .f .panel[hidden] {
    display: none;
  }

  .f .arch--panel {
    aspect-ratio: 16 / 9;
    margin-bottom: 1.75rem;
    border-radius: 28px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .f .panel.is-in .arch--panel {
      animation: f-panel-img 500ms var(--ease-out) both;
    }

    .f .panel.is-in > :not(.arch--panel) {
      animation: f-panel-text 450ms var(--ease-out) 60ms both;
    }
  }

  @keyframes f-panel-img {
    from {
      opacity: 0;
      transform: scale(0.97);
      filter: blur(6px);
    }
  }

  @keyframes f-panel-text {
    from {
      opacity: 0;
      transform: translateY(10px);
      filter: blur(3px);
    }
