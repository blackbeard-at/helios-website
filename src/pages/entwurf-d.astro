    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .d .flow {
    position: relative;
    aspect-ratio: 1200 / 560;
    margin-top: 12px;
  }

  .d .flow__glow {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 46%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      rgba(253, 196, 26, 0.55),
      rgba(255, 198, 163, 0.45) 45%,
      rgba(255, 198, 163, 0) 100%
