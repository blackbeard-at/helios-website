---
// Entwurf D – „Pergament & Sonne“
// Anmutung nach einer Stilreferenz (redaktioneller Tech-Look): warmer
// Pergament-Grund, Serifen-Headlines in normaler Stärke, Monospace für
// Menü und Labels, Pillen-Knöpfe, Haarlinien, Pastell-Schleier.
// Übertragen auf HELIOS: Wer Hilfe sucht, fließt in die HELIOS-Sonne und
// von dort zu den sechs Hilfen. Orange ist der einzige kräftige Akzent.
import { Image } from 'astro:assets';
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/jetbrains-mono';
import DraftLayout from '../layouts/DraftLayout.astro';
import HeliosMark from '../components/HeliosMark.astro';
import { contact, team } from '../data/site';
import { hilfen, mailto } from '../data/entwurf';
import vision from '../assets/images/vision.jpg';
import leitbild from '../assets/images/leitbild.jpg';

const nav = [
  { href: '#hilfen', label: 'Leistungen' },
  { href: '#arbeitsweise', label: 'Arbeitsweise' },
  { href: '#unser-leitbild', label: 'Unser Leitbild' },
  { href: '#team', label: 'Team' },
];


const werte = ['Respekt', 'Fairness', 'Vertrauen', 'Gleichberechtigung'];

const stufen = [
  { name: 'Erfassen', text: 'Belastungen und Ressourcen werden sichtbar, im Clearing oder im ersten Gespräch.' },
  { name: 'Planen', text: 'Mit Ihnen und dem Jugendamt gestalten wir die Hilfe bedarfsgerecht und individuell.' },
  { name: 'Begleiten', text: 'Alltagspraktisch, flexibel und gut erreichbar, bis es ohne uns geht.' },
];

const initials = (name: string) => {
  const parts = name.split(' ').filter((w) => !w.endsWith('.'));
  return (parts[0][0] + parts.at(-1)![0]).toUpperCase();
};

const year = new Date().getFullYear();
---

<DraftLayout title="Entwurf D · Pergament & Sonne">
  <div class="d">
    <p class="announce">
      <span>Ambulante Kinder- und Jugendhilfe in Bad Vilbel, erreichbar unter {contact.phone}</span>
      <a class="announce__pill" href={contact.phoneHref}>Anrufen</a>
    </p>

    <header class="bar">
      <a class="bar__logo" href="#top" aria-label="HELIOS – nach oben"><HeliosMark class="mark-intro" /></a>
      <nav class="bar__nav" id="nav-d" aria-label="Hauptmenü">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
      <div class="bar__actions">
        <a class="pill pill--dark" href="#kontakt">Kontakt</a>
        <a class="pill pill--accent" href={mailto('Anfrage über die Website')}>Hilfe anfragen</a>
      </div>
      <button class="bar__menu pill pill--ghost" type="button" aria-expanded="false" aria-controls="nav-d" data-menu>
        Menü
      </button>
    </header>

    <main id="top">
      <!-- Hero: Serifen-Headline, Monospace-Text, darunter der Fluss zur Sonne -->
      <section class="hero" aria-labelledby="hero-title">
        <h1 class="hero__title" id="hero-title">
          <span class="w" style="--i:0">Positive</span> <span class="w" style="--i:1">Perspektiven</span>
          <br />
          <span class="w" style="--i:2">für</span> <span class="w" style="--i:3">junge</span>{' '}<span
            class="w"
            style="--i:4">Menschen</span
          >
        </h1>
        <p class="hero__sub">
          HELIOS ist freier Träger der ambulanten Kinder- und Jugendhilfe. Gemeinsam mit Familien und Jugendämtern
          gestalten wir Hilfen, die nah am Menschen sind.
        </p>
        <p class="hero__actions">
          <a class="pill pill--accent pill--lg" href={mailto('Anfrage über die Website')}>Hilfe anfragen</a>
          <a class="pill pill--ghost pill--lg" href="#hilfen">Leistungen ansehen</a>
        </p>
      </section>

      <!-- Werte als langsames Laufband -->
      <section class="werte" aria-label="Unsere Werte">
        <div class="werte__track">
          {
            [0, 1].map((k) => (
              <p class="werte__row" aria-hidden={k === 1 ? 'true' : undefined}>
                {werte.map((w) => (
                  <>
                    <span>{w}</span>
                    <i class="werte__sun" />
                  </>
                ))}
                {werte.map((w) => (
                  <>
                    <span>{w}</span>
                    <i class="werte__sun" />
                  </>
                ))}
              </p>
            ))
          }
        </div>
      </section>

      <!-- Vision -->
      <section class="vision" aria-labelledby="vision-title">
        <div class="vision__text">
          <p class="label" data-rise>Unsere Vision</p>
          <h2 id="vision-title" data-rise>Gleiche Chancen auf ein selbstbestimmtes Leben</h2>
          <p data-rise>
            Wir wünschen uns eine Gesellschaft, in der junge Menschen, unabhängig von ihrer Herkunft, gleiche Chancen auf
            ein selbstbestimmtes und eigenverantwortliches Leben erhalten. Wir stärken Kinder, Jugendliche und ihre Familien
            darin, ihre Potenziale zu entfalten und Herausforderungen eigenständig zu meistern.
          </p>
        </div>
        <figure class="vision__media" data-rise>
          <span class="wash wash--peach" aria-hidden="true"></span>
          <Image
            src={vision}
            alt="Eine Pädagogin zeigt zwei Jungen ein kleines Bäumchen"
            widths={[480, 800, 1100]}
            sizes="(min-width: 900px) 46vw, 100vw"
          />
        </figure>
      </section>

      <!-- Leistungen als Karten -->
      <section class="hilfen" id="hilfen" aria-labelledby="hilfen-title">
        <header class="section-head">
          <p class="label" data-rise>Leistungen</p>
          <h2 id="hilfen-title" data-rise>Unsere Hilfen im Überblick</h2>
          <p data-rise>
            Gemeinsam mit den Hilfesuchenden und dem ortsansässigen Jugendamt wird jede Hilfe bedarfsgerecht und
            individuell gestaltet.
          </p>
        </header>
        <div class="cards">
          {
            hilfen.map((h) => (
              <article class="card" id={`hilfe-${h.id}`} data-rise>
                <p class="tag">{h.ref}</p>
                <h3>{h.name}</h3>
                <p class="card__fuer">{h.fuer}.</p>
                <details class="card__more" data-more>
                  <summary>Mehr erfahren</summary>
                  <div class="card__detail">
                    {h.intro.length > 0 && <p>{h.intro.join(' ')}</p>}
                    {h.blocks.map((b) =>
                      b.type === 'h' ? (
                        <h4>{b.text}</h4>
                      ) : b.type === 'p' ? (
                        <p>{b.text}</p>
                      ) : (
                        <ul>
                          {b.items.map((it) => (
                            <li>{it.replace('\n', ' ')}</li>
                          ))}
                        </ul>
                      ),
                    )}
                    <p class="card__actions">
                      <a class="pill pill--accent" href={mailto(`Anfrage: ${h.name}`)}>
                        Anfragen
                      </a>
                      {h.law && (
                        <a class="pill pill--ghost" href={h.law.href} target="_blank" rel="noopener">
                          Gesetzestext
                        </a>
                      )}
                    </p>
                  </div>
                </details>
              </article>
            ))
          }
        </div>
        <!-- Details aller Hilfen in einem Seitenpanel statt Aufklappen in der Karte -->
        <dialog class="drawer" aria-labelledby="drawer-title" data-drawer>
          <div class="drawer__head">
            <div>
              <p class="tag" data-drawer-ref></p>
              <h3 id="drawer-title" data-drawer-title></h3>
            </div>
            <button class="drawer__close" type="button" data-drawer-close aria-label="Schließen">×</button>
          </div>
          <div class="drawer__body" data-drawer-body></div>
        </dialog>
      </section>

      <!-- Arbeitsweise: Pastell-Fläche, Linie mit wanderndem Punkt -->
      <section class="arbeit" id="arbeitsweise" aria-labelledby="arbeit-title">
        <div class="arbeit__panel">
          <span class="wash wash--butter" aria-hidden="true"></span>
          <span class="wash wash--sky" aria-hidden="true"></span>
          <p class="label" data-rise>Arbeitsweise</p>
          <h2 id="arbeit-title" data-rise>Schnell, flexibel und nah am Menschen</h2>
          <div class="track" aria-hidden="true"><span class="track__dot"></span></div>
          <ol class="stufen">
            {
              stufen.map((s) => (
                <li data-rise>
                  <h3>{s.name}</h3>
                  <p>{s.text}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <!-- Unser Leitbild: Bild links, rechts Headline über dem Text -->
      <section class="haltung" id="unser-leitbild" aria-labelledby="haltung-title">
        <div class="haltung__grid">
          <figure class="haltung__media" data-rise>
            <Image
              src={leitbild}
              alt="Ein Vater baut mit zwei Söhnen ein Windrad-Modell zusammen"
              widths={[480, 800]}
              sizes="(min-width: 900px) 40vw, 100vw"
            />
          </figure>
          <div class="haltung__text" data-rise>
            <p class="label">Unser Leitbild</p>
            <h2 class="haltung__quote" id="haltung-title">
              Wir richten unsere Arbeit konsequent an den Ressourcen und Bedürfnissen der jungen Menschen und ihrer
              Familien aus.
            </h2>
            <p>
              Ziel ist es, durch nachhaltig wirksame Maßnahmen die Notwendigkeit sozialpädagogischer Hilfen langfristig zu
              beenden und die Kompetenz zur selbstbestimmten Lebensführung zu fördern.
            </p>
            <p>
              Unsere Fachkräfte aus pädagogischen und psychologischen Disziplinen entwickeln individuelle,
              ressourcenorientierte und systemische Handlungsstrategien. Durch vertrauensvolle Zusammenarbeit entstehen
              tragfähige Beziehungen, die echte Veränderung ermöglichen.
            </p>
          </div>
        </div>
      </section>

      <!-- Team -->
      <section class="team" id="team" aria-labelledby="team-title">
        <header class="section-head">
          <p class="label" data-rise>Team</p>
          <h2 id="team-title" data-rise>Ihre Ansprechpartner</h2>
        </header>
        <ul class="people">
          {
            team.map((p) => (
              <li class="person" data-rise>
                <span class="person__initials" aria-hidden="true">
                  {initials(p.name)}
                </span>
                <h3>{p.name}</h3>
                <p class="person__role">{[...p.lines, p.role].join(' · ')}</p>
                <a class="pill pill--ghost pill--sm" href={`mailto:${p.email}`}>
                  E-Mail schreiben
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Kontakt -->
      <section class="kontakt" id="kontakt" aria-labelledby="kontakt-title">
        <div class="kontakt__panel">
          <div class="flow__glow flow__glow--cta" aria-hidden="true"></div>
          <span class="kontakt__sun" aria-hidden="true"><HeliosMark variant="icon" class="mark-emit" /></span>
          <h2 id="kontakt-title" data-rise>Sprechen Sie mit uns</h2>
          <p data-rise>Familien, junge Menschen und Fachkräfte der Jugendämter erreichen uns direkt.</p>
          <p class="kontakt__actions" data-rise>
            <a class="pill pill--accent pill--lg" href={contact.phoneHref}>{contact.phone}</a>
            <a class="pill pill--dark pill--lg" href={`mailto:${contact.email}`}>{contact.email}</a>
          </p>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="foot__brand">
        <HeliosMark class="mark-intro" />
        <p>Freier Träger der ambulanten Kinder- und Jugendhilfe.</p>
      </div>
      <div>
        <p class="label">Adresse</p>
        <p>{contact.company}<br />{contact.street}<br />{contact.city}</p>
        <p><a class="link" href={contact.mapsLink} target="_blank" rel="noopener">In Google Maps öffnen</a></p>
      </div>
      <div>
        <p class="label">Kontakt</p>
        <p>
          Telefon <a class="link" href={contact.phoneHref}>{contact.phone}</a><br />
          Fax {contact.fax}<br />
          <a class="link" href={`mailto:${contact.email}`}>{contact.email}</a>
        </p>
      </div>
      <div>
        <p class="label">Rechtliches</p>
        <p>Geschäftsführung: {contact.management}<br />{contact.court.replace(':', '')}, {contact.register}</p>
        <p><a class="link" href="/impressum">Impressum</a> · <a class="link" href="/datenschutz">Datenschutz</a></p>
      </div>
      <p class="foot__meta">© {`${year} ${contact.brand}`}</p>
    </footer>
  </div>
</DraftLayout>

<script>
  import { initRise } from '../scripts/draft';
  initRise();

  // Leistungen: „Mehr erfahren“ öffnet ein Seitenpanel, die Kartenreihe bleibt
  // gleich hoch. Ohne JS klappen die Karten wie bisher auf.
  const drawer = document.querySelector<HTMLDialogElement>('[data-drawer]');
  if (drawer && 'showModal' in drawer) {
    const body = drawer.querySelector<HTMLElement>('[data-drawer-body]')!;
    let opener: HTMLElement | null = null;
    const close = () => {
      drawer.classList.add('is-closing');
      setTimeout(() => {
        drawer.classList.remove('is-closing');
        drawer.close();
        opener?.focus();
      }, 200);
    };
    document.querySelectorAll<HTMLDetailsElement>('[data-more]').forEach((d) => {
      const summary = d.querySelector('summary')!;
      summary.addEventListener('click', (e) => {
        e.preventDefault();
        const card = d.closest('.card')!;
        drawer.querySelector('[data-drawer-ref]')!.textContent = card.querySelector('.tag')!.textContent;
        drawer.querySelector('[data-drawer-title]')!.textContent = card.querySelector('h3')!.textContent;
        body.replaceChildren(...[...d.querySelector('.card__detail')!.children].map((n) => n.cloneNode(true)));
        opener = summary as HTMLElement;
        drawer.showModal();
        body.scrollTop = 0;
      });
    });
    drawer.querySelector('[data-drawer-close]')!.addEventListener('click', close);
    drawer.addEventListener('cancel', (e) => {
      e.preventDefault();
      close();
    });
    drawer.addEventListener('click', (e) => {
      if (e.target === drawer) close();
    });
  }

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Kopfleiste bekommt beim Scrollen eine Haarlinie
  const bar = document.querySelector<HTMLElement>('.bar')!;
  const onScroll = () => bar.classList.toggle('is-stuck', scrollY > 60);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Menü auf dem Telefon
  const menu = document.querySelector<HTMLButtonElement>('[data-menu]')!;
  menu.addEventListener('click', () => {
    const open = menu.getAttribute('aria-expanded') !== 'true';
    menu.setAttribute('aria-expanded', String(open));
    bar.classList.toggle('is-open', open);
  });
  bar.querySelectorAll('.bar__nav a').forEach((a) =>
    a.addEventListener('click', () => {
      menu.setAttribute('aria-expanded', 'false');
      bar.classList.remove('is-open');
    }),
  );

  // Arbeitsweise: Punkt wandert mit dem Scrollen über die Linie
  const track = document.querySelector<HTMLElement>('.track');
  if (track && !reduce) {
    const panel = track.closest('section')!;
    const upd = () => {
      const r = panel.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (innerHeight - r.top) / (innerHeight + r.height * 0.6)));
      track.style.setProperty('--p', p.toFixed(3));
    };
    addEventListener('scroll', upd, { passive: true });
    upd();
  }
</script>

<style is:global>
  /* ---------- Tokens (nur Entwurf D) ---------- */
  .d {
    --parchment: #f6f3ef;
    --sand: #efe9e2;
    --ink: #1d1c1b;
    --graphite: #4a4744;
    --smoke: #69655f;
    --ash: #d9d2ca;
    --accent: #ec6622;
    --apricot: #f39222;
    --butter: #fdc41a;
    --peach: #ffc6a3;
    --butter-soft: #fde7a3;
    --sky-soft: #cddcf3;

    --serif: 'Source Serif 4 Variable', Georgia, 'Times New Roman', serif;
    --mono: 'JetBrains Mono Variable', 'IBM Plex Mono', ui-monospace, monospace;
    --wrap: min(1432px, 100% - 2 * var(--gutter));
    --gutter: clamp(20px, 3vw, 44px);
    --ease: cubic-bezier(0.22, 1, 0.36, 1);

    /* Schleier und Leuchten dürfen über den Rand ragen, ohne seitlich zu scrollen */
    overflow-x: clip;
    background: var(--parchment);
    color: var(--graphite);
    font-family: var(--mono);
    font-size: 16px;
    line-height: 1.6;
    letter-spacing: -0.01em;
  }

  body:has(.d) {
    background: #f6f3ef;
  }

  .d h1,
  .d h2,
  .d h3 {
    color: var(--ink);
    font-family: var(--serif);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.12;
  }

  .d h2 {
    font-size: clamp(34px, 3.6vw, 52px);
  }

  .d h3 {
    font-size: 26px;
  }

  .d .label {
    color: var(--smoke);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .d .link {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--ash);
    text-underline-offset: 0.25em;
    transition: text-decoration-color 0.2s ease;
  }

  .d .link:hover {
    text-decoration-color: var(--accent);
  }

  /* Pillen-Knöpfe: Monospace, Großbuchstaben, 100px Radius */
  .d .pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 10px 22px;
    border: 1px solid transparent;
    border-radius: 100px;
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease,
      transform 0.25s var(--ease);
  }

  .d .pill:active {
    transform: scale(0.97);
  }

  .d .pill--lg {
    min-height: 52px;
    padding: 14px 28px;
    font-size: 15px;
  }

  .d .pill--sm {
    min-height: 40px;
    padding: 8px 16px;
    font-size: 13px;
  }

  /* Dunkle Schrift auf Orange: 5:1 statt 3:1 mit Weiß */
  .d .pill--accent {
    background: var(--accent);
    color: var(--ink);
  }

  .d .pill--accent:hover {
    background: var(--apricot);
  }

  .d .pill--dark {
    background: #242424;
    color: var(--parchment);
  }

  .d .pill--dark:hover {
    background: #3a3836;
  }

  .d .pill--ghost {
    border-color: var(--ash);
    background: transparent;
    color: var(--ink);
  }

  .d .pill--ghost:hover {
    border-color: var(--ink);
    background: var(--sand);
  }

  /* ---------- Hinweisleiste und Kopf ---------- */
  .d .announce {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px 18px;
    padding: 12px var(--gutter);
    background: #000;
    color: var(--parchment);
    font-size: 14px;
    text-align: center;
  }

  .d .announce__pill {
    padding: 6px 14px;
    border-radius: 100px;
    background: var(--parchment);
    color: var(--ink);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 0.2s ease;
  }

  .d .announce__pill:hover {
    background: var(--butter-soft);
  }

  .d .bar {
    position: sticky;
    z-index: 30;
    top: 0;
    display: flex;
    align-items: center;
    gap: 40px;
    padding: 22px var(--gutter);
    background: var(--parchment);
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.3s ease,
      padding 0.3s ease;
  }

  .d .bar.is-stuck {
    padding-block: 14px;
    border-bottom-color: var(--ash);
  }

  .d .bar__logo svg {
    width: auto;
    height: 40px;
  }

  .d .bar__nav {
    display: flex;
    gap: 32px;
  }

  .d .bar__nav a {
    position: relative;
    color: var(--ink);
    font-size: 15px;
    letter-spacing: 0.02em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .d .bar__nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease);
  }

  .d .bar__nav a:hover::after {
    transform: scaleX(1);
  }

  .d .bar__actions {
    display: flex;
    gap: 10px;
    margin-left: auto;
  }

  .d .bar__menu {
    display: none;
  }

  @media (max-width: 1000px) {
    .d .bar {
      gap: 12px;
      padding-block: 14px;
    }

    .d .bar__logo svg {
      height: 32px;
    }

    .d .bar__actions .pill--dark {
      display: none;
    }

    .d .bar__actions {
      margin-left: auto;
    }

    .d .bar__actions .pill {
      min-height: 40px;
      padding: 8px 14px;
      font-size: 12px;
    }

    .d .bar__menu {
      display: inline-flex;
      min-height: 40px;
      padding: 8px 14px;
      font-size: 12px;
    }

    .d .bar__nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      padding: 8px var(--gutter) 24px;
      border-bottom: 1px solid var(--ash);
      background: var(--parchment);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-6px);
      transition:
        opacity 0.2s ease,
        transform 0.3s var(--ease),
        visibility 0s linear 0.3s;
    }

    .d .bar.is-open .bar__nav {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition:
        opacity 0.2s ease,
        transform 0.3s var(--ease);
    }

    .d .bar__nav a {
      padding: 14px 0;
      border-bottom: 1px solid var(--ash);
      font-size: 16px;
    }
  }

  /* ---------- Hero ---------- */
  .d .hero {
    width: var(--wrap);
    margin: 0 auto;
    padding-top: clamp(64px, 9vh, 120px);
    text-align: center;
  }

  .d .hero__title {
