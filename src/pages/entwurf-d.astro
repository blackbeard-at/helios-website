  .d .line__base {
    fill: none;
    stroke: var(--ash);
    stroke-width: 1.2;
    transition:
      stroke 0.35s ease,
      opacity 0.35s ease;
  }

  .d .line__dash {
    fill: none;
    stroke: var(--apricot);
    stroke-width: 1.6;
    stroke-dasharray: 6 18;
    opacity: 0.55;
    transition: opacity 0.35s ease;
  }

  .d .dot {
    fill: var(--accent);
  }

  .d .dot--out {
    fill: var(--butter);
    stroke: var(--apricot);
    stroke-width: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .d .line__dash {
      animation: flow-dash 2.4s linear infinite;
    }
  }

  @keyframes flow-dash {
    to {
      stroke-dashoffset: -48;
    }
  }

  /* Auswahl: passende Wege leuchten, der Rest tritt zurück */
  .d .flow[data-active] .line {
    opacity: 0.22;
    transition: opacity 0.35s ease;
  }

  .d .flow[data-active] .line.is-on,
  .d .flow[data-active='alle'] .line,
  .d .flow[data-active='jung'] .line--out.g-jung,
  .d .flow[data-active='familie'] .line--out.g-familie,
  .d .flow[data-active='erwachsen'] .line--out.g-erwachsen {
    opacity: 1;
  }

  .d .flow[data-active] .line.is-on .line__base,
  .d .flow[data-active='alle'] .line .line__base,
  .d .flow[data-active='jung'] .line--out.g-jung .line__base,
  .d .flow[data-active='familie'] .line--out.g-familie .line__base,
  .d .flow[data-active='erwachsen'] .line--out.g-erwachsen .line__base {
    stroke: var(--accent);
  }

  .d .flow__in,
  .d .flow__out {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .d .flow__in li,
  .d .flow__out li {
    position: absolute;
    top: calc(var(--y) / 560 * 100%);
    transform: translateY(-50%);
  }

  .d .flow__in li {
    right: calc(100% - 232 / 1200 * 100%);
  }

  .d .flow__out li {
    left: calc(968 / 1200 * 100%);
  }

  .d .node {
    display: inline-flex;
