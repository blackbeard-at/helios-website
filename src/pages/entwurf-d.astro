    filter: blur(8px);
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Die Sonne geht auf und „atmet“ danach ruhig */
    .js .d .flow .flow__glow {
